<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!--
      Log directory is resolved as:
        1. System property -Dapp.log.dir=<path>
        2. Default: logs/ relative to working directory
    -->
    <property name="LOG_DIR"     value="${app.log.dir:-logs}"/>
    <property name="LOG_NAME"    value="${app.log.name:-app}"/>
    <property name="LOG_FILE"    value="${LOG_DIR}/${LOG_NAME}.log"/>
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%logger{36}] %msg%n"/>

    <!-- Console (stdout) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Daily rolling file — the active log is always LOG_FILE -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/${LOG_NAME}-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Infrastructure noise: only surface warnings and above -->
    <logger name="org.eclipse.jetty"  level="WARN"/>
    <logger name="org.apache.wicket"  level="WARN"/>

    <!-- CSRF / resource-isolation rejections. Under the WARN above, a blocked
         request produced a bare 403 in the browser and nothing in the log. INFO
         restores the "Possible CSRF attack … aborted with error 403" line, which
         carries the URL. Do NOT lower this to DEBUG: that logs a line for every
         request, and the topbar polls every two seconds. -->
    <logger name="org.apache.wicket.protocol.http.ResourceIsolationRequestCycleListener"
            level="INFO"/>

    <!-- QuickFIX/J session events (logon, logout, reconnects, seq resets) — keep at INFO -->
    <logger name="quickfixj.event"    level="INFO"/>
    <!-- QuickFIX/J per-message raw logs are DEBUG — silenced at root INFO level;
         enable individually when raw protocol tracing is needed -->
    <logger name="quickfixj.msg"      level="DEBUG"/>
    <!-- QuickFIX/J internals -->
    <logger name="quickfix"           level="WARN"/>

    <!-- Our application code -->
    <logger name="com.npsoftdev" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
